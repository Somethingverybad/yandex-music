{
  "name": "theif",
  "productName": "TheIf",
  "version": "1.0.0",
  "description": "Мини-плеер-виджет Яндекс Музыки и ВК Музыки поверх окон со скачиванием треков",
  "main": "src/main/index.js",
  "license": "MIT",
  "author": {
    "name": "ancher",
    "email": "simbagoapp@gmail.com"
  },
  "homepage": "https://github.com/cptn73m0/ya-music-desktop",
  "scripts": {
    "start": "electron .",
    "dev": "YMW_DEV=1 electron .",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:win": "electron-builder --win nsis portable",
    "dist:mac": "electron-builder --mac dmg",
    "prepare:ffmpeg": "node scripts/prepare-ffmpeg.js"
  },
  "dependencies": {
    "dbus-next": "^0.9.2",
    "hls.js": "^1.7.0",
    "mpris-service": "^2.1.2",
    "node-id3": "^0.2.9"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "ffmpeg-static": "^5.3.0"
  },
  "build": {
    "appId": "dev.theif.app",
    "productName": "TheIf",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!node_modules/ffmpeg-static/**"
    ],
    "asarUnpack": [
      "assets/bin/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons",
      "category": "AudioVideo;Audio;Player;",
      "syncDesktopName": true,
      "executableArgs": [
        "--ozone-platform=x11"
      ],
      "synopsis": "Мини-плеер Яндекс Музыки и ВК Музыки",
      "desktop": {
        "entry": {
          "Name": "TheIf",
          "GenericName": "Музыкальный плеер",
          "Comment": "Мини-плеер Яндекс Музыки и ВК Музыки поверх окон",
          "Categories": "AudioVideo;Audio;Player;",
          "Keywords": "music;player;yandex;vk;музыка;плеер;яндекс;вк;",
          "StartupWMClass": "theif",
          "StartupNotify": "true"
        }
      },
      "description": "Виджет-плеер поверх окон для Яндекс Музыки и ВК Музыки: обложка, перемотка, громкость, очередь и скачивание треков в mp3 с тегами.",
      "maintainer": "ancher <simbagoapp@gmail.com>"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon-mac.png",
      "category": "public.app-category.music"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libsecret-1-0"
      ],
      "priority": "optional"
    }
  }
}
